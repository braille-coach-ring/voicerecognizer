# Hugging Face Hub 設定 (braille-mate Organization)
# 公開モデルの推論利用時は設定不要 (ゼロコンフィグ) で動作します。
# モデルの学習・アップロードを行う場合のみ Write 権限付きトークンを設定してください。

# 認証トークン (VOICERECOGNIZER_HF_TOKEN または HF_TOKEN)
VOICERECOGNIZER_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# リポジトリ ID (デフォルト: braille-mate/braille-mate-hiragana-recognizer)
VOICERECOGNIZER_HF_REPO_ID=braille-mate/braille-mate-hiragana-recognizer

# ベストモデル更新時の自動アップロード (true / false)
VOICERECOGNIZER_HF_AUTO_UPLOAD=false

# キャッシュディレクトリ (省略時は ~/.cache/voicerecognizer)
# VOICERECOGNIZER_CACHE_DIR=/path/to/cache
